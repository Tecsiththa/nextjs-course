// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}


datasource db {
  provider = "postgresql"
}


model User{

  id String @id @default(uuid())     // id eka ibema genarate wenna  
  email String @unique   // eka mail ekaka inna puluwan ekkenekta vitharai
  phone String?    // phone add karanna aniwarya na habai ekak vithrai thienna puluwan
  firstName String
  lastName String
  password String
  role String @default("CUSTOMER") // role eka default wenne customer ekak widiyata
  status String @default("ACTIVE") // status eka default wenne active widiyata
  createdAt DateTime @default(now()) // user ekak create karapu welawata date eka ganna
  lastLogin DateTime?
  privileges String[] @default([])
  
}